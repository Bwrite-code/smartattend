# ── Backend mode ──────────────────────────────────────────────
# 'mock'     → built-in demo backend with sample data (no setup needed)
# 'supabase' → real Supabase project (fill in the two values below,
#              run supabase/migrations/0001_init.sql first)
VITE_BACKEND_MODE=mock

# ── Supabase (only needed when VITE_BACKEND_MODE=supabase) ────
# Use the PUBLIC anon/publishable key — NEVER the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
